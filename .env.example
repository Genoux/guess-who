# Origin for links that leave the app; Vercel provides VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# Optional
NEXT_PUBLIC_SENTRY_DSN=
# Set by Vercel: VERCEL_ENV. Mirror it as NEXT_PUBLIC_VERCEL_ENV for browser Sentry events.
NEXT_PUBLIC_VERCEL_ENV=

# Build-time only (source map upload in next.config.ts)
SENTRY_ORG=inbeat-67
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
