# Origin for links that leave the app; Vercel provides VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# Neon branch connection string (dev branch locally, never production).
DATABASE_URL=

# Clerk. Locally, `bunx clerk@latest init --accountless` writes development keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional
NEXT_PUBLIC_SENTRY_DSN=
# Rate limits share counters across instances through Upstash; without them each instance counts alone.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set by Vercel: VERCEL_ENV. Mirror it as NEXT_PUBLIC_VERCEL_ENV for browser Sentry events.
NEXT_PUBLIC_VERCEL_ENV=

# Build-time only (source map upload in next.config.ts)
SENTRY_ORG=inbeat-67
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
